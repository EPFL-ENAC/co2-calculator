<ul><% for (const item of items) { %><li><% if (item.children) { %><details<%= item.keys.includes(current) ? " open" : "" %>><summary><%= item.title %></summary><%~ include('/partials/nav', { items: item.children, current, root }) %></details><% } else { %><a href="<%= root + item.key %>.html"<%~ item.key === current ? ' aria-current="page"' : "" %>><%= item.title %></a><% } %></li><% } %></ul>
