# EPFL institution values of the frontend (#3244).
#
# Copy this file to frontend.env (git-ignored). `make install` does it if the
# file is missing. Docker Compose, the dev server and the frontend tests read
# frontend.env. The EPFL clusters get the same values from the ops repository. Per-cluster
# values (APP_ENVIRONMENT, APP_SENTRY_DSN, APP_MATOMO_*, APP_OPS_*) are not
# here. The full list of values is in
# docs/src/implementation-plans/3244-institution-values-assets-theme.md.

# Required.
APP_INSTITUTION_NAME=EPFL
APP_INSTITUTION_NAME_FR_DE=de l'EPFL
APP_INSTITUTION_NAME_FR_A=à l'EPFL
APP_INSTITUTIONAL_ID_LABEL=SCIPER
APP_CONTACT_EMAIL=co2calculator@epfl.ch
APP_USER_DOC_URL=https://epfl-enac.github.io/co2-calculator-user-doc/
APP_BACKOFFICE_DOC_URL=https://epfl-enac.github.io/co2-calculator-back-office-doc/
APP_STRATEGY_URL_EN=https://www.epfl.ch/about/sustainability/strategy/
APP_STRATEGY_URL_FR=https://www.epfl.ch/about/sustainability/fr/strategie/

# Optional. An empty value hides the link.
APP_ACCESS_MANAGEMENT_URL=https://accred.epfl.ch?opentab=authorizations
APP_ACCESS_MANAGEMENT_ABOUT_URL=https://www.epfl.ch/campus/services/ressources/accred/
APP_ROLES_DOC_URL=https://epfl-enac.github.io/co2-calculator-back-office-doc/roles/
APP_SOURCE_CODE_URL=https://github.com/EPFL-ENAC/co2-calculator
APP_USER_DOC_SOURCE_URL=https://github.com/EPFL-ENAC/co2-calculator-user-doc
APP_BACKOFFICE_DOC_SOURCE_URL=https://github.com/EPFL-ENAC/co2-calculator-back-office-doc
APP_DEVELOPER_DOC_URL=https://epfl-enac.github.io/co2-calculator/
APP_PLANNER_MIN_YEAR=2016
APP_PLANNER_MAX_YEAR=2050
