# ==============================================================================
# Build Stage: Build Storybook static site
# ==============================================================================
FROM node:26-alpine AS builder

WORKDIR /app

# Install frontend deps (vue, quasar, etc. — storybook resolves them via parent node_modules)
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts

# Install storybook deps in its own isolated tree
COPY storybook/package.json storybook/package-lock.json ./storybook/
RUN cd storybook && npm ci --ignore-scripts

# Copy source code (be selective to avoid copying node_modules)
COPY src/ ./src/
COPY storybook/ ./storybook/
COPY index.html tsconfig.json quasar.config.js quasar.extensions.json ./
# The Storybook build writes injectEnv.js, theme.css and the institution
# folder with the container scripts (#3244). storybook/.storybook/main.ts
# reads institutions/epfl, which is outside this build context: the workflow
# passes the institutions folder as the named context "institutions", and it
# lands at ../institutions from /app.
COPY build/ ./build/
COPY docker/ ./docker/
COPY institution-default/ ./institution-default/
COPY --from=institutions . /institutions/

# Prepare Quasar (generates .quasar/)
RUN npx quasar prepare

# Build Storybook static site (creates ./storybook/storybook-static)
RUN cd storybook && npm run build

# ==============================================================================
# Production Stage: Serve the built Storybook site with Nginx
# ==============================================================================
FROM nginxinc/nginx-unprivileged:stable-alpine-slim

# Install wget for healthcheck. The base runs as uid 101 (nginx), apk needs root.
USER root
RUN apk add --no-cache wget
USER 101

# Remove default nginx config
RUN rm /etc/nginx/conf.d/default.conf

# Create simple nginx config for Storybook SPA
RUN echo 'server { \
    listen 8080; \
    server_name localhost; \
    root /usr/share/nginx/html; \
    index index.html; \
    \
    # Health endpoint for load balancers \
    location = /health { \
      return 200 "ok"; \
      add_header Content-Type text/plain; \
    } \
    \
    # SPA fallback: try file, then directory, then index.html \
    location / { \
      try_files $uri $uri/ /index.html; \
    } \
}' > /etc/nginx/conf.d/default.conf

# Copy built static files from build stage
COPY --from=builder /app/storybook/storybook-static /usr/share/nginx/html

# Expose port 8080 for security reasons (non-privileged)
EXPOSE 8080

# Start nginx in foreground
CMD ["nginx", "-g", "daemon off;"]

HEALTHCHECK --interval=30s --timeout=3s CMD wget -qO- http://127.0.0.1:8080/health || exit 1

