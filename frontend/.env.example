# Local dev settings. Copy to .env.local (gitignored) and fill in.
#
# Every APP_* value is a runtime value. In the container docker/entrypoint.sh
# writes the APP_* environment variables to /injectEnv.js at startup. Under
# `quasar dev` build/institution.mjs runs the same script, with the values of
# INSTITUTION_ENV_FILE and of this file (this file wins). In production the
# values come from helm/values.yaml frontend.env, not from this file.

# Institution (#3244). Both paths are required, relative to frontend/.
# frontend.env is a copy of frontend.env.example (`make install` makes it).
INSTITUTION_ENV_FILE=../institutions/epfl/frontend.env
INSTITUTION_ASSETS_DIR=../institutions/epfl/assets

# GlitchTip DSN. Empty / unset → src/boot/sentry.ts skips Sentry.init
# (no events sent). Use the project DSN from your GlitchTip dashboard.
APP_SENTRY_DSN=

# Environment label attached to every event. Conventional values: development,
# stage, production. Lets you filter events per env in GlitchTip.
APP_ENVIRONMENT=development

# Matomo analytics. APP_MATOMO_SITE_ID is the on/off switch: empty / unset →
# src/boot/matomo.ts loads no tracker and sends nothing. With a site id,
# APP_MATOMO_URL is required.
APP_MATOMO_URL=
APP_MATOMO_SITE_ID=

# Demo instance. APP_DEMO_MODE=true replaces the whole app (login included)
# with a notice linking to APP_PRODUCTION_URL, which is then required.
APP_DEMO_MODE=false
APP_PRODUCTION_URL=
