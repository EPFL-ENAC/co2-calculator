# Local dev overrides. Copy to .env.local (gitignored) and fill in.
# Only APP_*-prefixed vars listed in quasar.config.js's build.env are exposed
# to the bundle.
#
# In production these come from the pod's environment via Helm
# (helm/values.yaml frontend.env) and are written to /injectEnv.js by
# docker/entrypoint.sh at container startup — NOT from this file.

# GlitchTip DSN. Empty / unset → src/boot/sentry.ts skips Sentry.init
# (no events sent). Use the project DSN from your GlitchTip dashboard.
APP_SENTRY_DSN=

# Environment label attached to every event. Conventional values: development,
# stage, production. Lets you filter events per env in GlitchTip.
APP_ENVIRONMENT=development

# -----------------------------------------------------------------------------
# Institution identity (#500)
# -----------------------------------------------------------------------------
# Everything that names or brands the institution that runs this instance.
# No variable has a code default. When a required one is empty, the app does
# not start and names the missing variable on the page
# (src/config/requiredConfig.ts). The values below are the EPFL values.

# Short name. Replaces the %institution% token in src/i18n texts, and starts
# the page title ("<name> CO2 Calculator"). Use a name that reads without an
# article in English ("at EPFL").
# Required.
APP_INSTITUTION_NAME=EPFL
# French forms with the preposition and the article, which depend on the name
# ("de l'EPFL" but "du CERN", "à l'EPFL" but "au CERN"). Required.
APP_INSTITUTION_NAME_FR_DE=de l'EPFL
APP_INSTITUTION_NAME_FR_A=à l'EPFL
# Label of the personal identifier of a member (headcount forms and tables).
# Required.
APP_INSTITUTION_ID_LABEL=SCIPER

# Logo, favicon, login illustration, fonts and theme are files, not variables:
# they come from the institution assets folder served at /institution/. In
# `quasar dev` that is INSTITUTION_ASSETS_DIR below. A container mounts the
# folder at /usr/share/nginx/html/institution (see
# docker/check-institution-assets.sh for the required files).

# The colors and border radii are the theme: the theme.env file of the same
# folder, one token=value line. colors-accent is required; a token left out
# keeps the base design. The tokens are listed in src/utils/institutionTheme.ts
# and institution/epfl/theme.env is the EPFL theme.

# Support address shown in help texts (%contact_email% token). Required.
APP_INSTITUTION_CONTACT_EMAIL=co2calculator@epfl.ch
# Sustainability strategy page linked from the home page, per language.
# Required.
APP_INSTITUTION_STRATEGY_URL=https://www.epfl.ch/about/sustainability/strategy/
APP_INSTITUTION_STRATEGY_URL_FR=https://www.epfl.ch/about/sustainability/fr/strategie/
# Documentation site roots, no trailing slash. The texts append the page path.
# Required.
APP_INSTITUTION_USER_DOC_URL=https://epfl-enac.github.io/co2-calculator-user-doc
APP_INSTITUTION_BACKOFFICE_DOC_URL=https://epfl-enac.github.io/co2-calculator-back-office-doc

# -----------------------------------------------------------------------------
# Institution services
# -----------------------------------------------------------------------------
# Access management portal where roles are delegated. Free text, not the
# backend ROLE_PROVIDER_TYPE / UNIT_PROVIDER_TYPE. The name is required: the
# texts name it (%access_provider% token). An empty URL hides the portal links
# of the access popover and of the user management page.
APP_INSTITUTION_ACCESS_PROVIDER_NAME=Accred
APP_INSTITUTION_ACCESS_PROVIDER_URL=
APP_INSTITUTION_ACCESS_PROVIDER_ABOUT_URL=
# Page that explains the calculator roles, linked from the same popover.
APP_INSTITUTION_ROLES_DOC_URL=
# Recipient of the Equipment "power feedback" email.
APP_INSTITUTION_EQUIPMENT_FEEDBACK_EMAIL=

# Matomo analytics. The site id is the on/off switch: empty → src/boot/matomo.ts
# loads no tracker and sends nothing. Each instance (dev, stage, prod) has its
# own site id, set in the ops repo. A site id without a URL stops the startup.
APP_INSTITUTION_MATOMO_URL=https://enac-webanalytics.epfl.ch/piwik/
APP_INSTITUTION_MATOMO_SITE_ID=

# Production instance that the demo notice links to. Required when
# APP_DEMO_MODE=true.
APP_INSTITUTION_PRODUCTION_URL=https://go.epfl.ch/co2

# -----------------------------------------------------------------------------
# Instance settings
# -----------------------------------------------------------------------------
# Project-planner horizon: bounds for the plan start/end year selects.
# No code default: empty → the year selects render empty.
APP_PLANNER_MIN_YEAR=YYYY
APP_PLANNER_MAX_YEAR=YYYY

# Operations links of the system logs page (GitOps, monitoring, logs, platform
# per environment), a JSON array on one line. Empty → no links. A value that
# does not parse stops the startup. Format:
# [{"name":"dev","gitops":[{"label":"GitOps","url":"https://..."}],"monitoring":[],"appLogs":[],"platform":[]}]
APP_SYSTEM_LINKS=

# Source repository of this code, linked from the texts editing page. Empty →
# no links.
APP_SOURCE_REPOSITORY_URL=https://github.com/EPFL-ENAC/co2-calculator/blob/dev

# Demo instance. APP_DEMO_MODE=true replaces the whole app (login included)
# with a notice that links to APP_INSTITUTION_PRODUCTION_URL. Any other value
# → normal app.
APP_DEMO_MODE=false

# -----------------------------------------------------------------------------
# Development server
# -----------------------------------------------------------------------------
# Institution assets folder that `quasar dev` serves at /institution/, relative
# to frontend/. Required for `quasar dev`. Not read by the container.
INSTITUTION_ASSETS_DIR=institution/epfl
